            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"message\": \"Hello, I really loved your portfolio! Would love to collaborate.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/contact",
          "host": ["{{base_url}}"],
          "path": ["api", "contact"]
        },
        "description": "Valid contact form submission. Expected: 200 OK { ok: true, message: '...' }"
      },
      "response": []
    },
